// End-to-end fixture: every mapping the generator knows, run through several configurations.
// `task test` runs the real `prisma generate` over this directory and compares the result with
// test/e2e/expected.

datasource db {
  provider = "postgresql"
}

// Nothing but the defaults (enumer and go.mod aside, so the output does not depend on local tools).
generator defaults {
  provider      = "node ./bin/prisma-go-generator.js"
  output        = "../out/defaults"
  enumer        = "false"
  generateGoMod = "true"
  goModule      = "example.com/e2e/defaults"
  goVersion     = "1.27"
}

// Every option moved off its default, one file per .prisma file.
generator custom {
  provider        = "node ./bin/prisma-go-generator.js"
  output          = "../out/custom"
  package         = "store"
  emitPerFile     = "true"
  inputs          = "all"
  structTags      = ["json:snake", "db", "yaml:camel"]
  omitempty       = ["json", "yaml"]
  types           = ["Int=int", "db.SmallInt=int16", "db.Uuid=uuid.UUID", "Decimal=github.com/shopspring/decimal.Decimal", "Json=map[string]any"]
  optionalType    = "database/sql.Null"
  enumType        = "string"
  initialisms     = ["ID", "IP"]
  tableNameMethod = "true"
  generateGoMod   = "true"
  goModule        = "example.com/e2e/custom"
  goVersion       = "1.27"
}

// One file per model, a subset of the inputs, no relations, small integer enums.
generator permodel {
  provider      = "node ./bin/prisma-go-generator.js"
  output        = "../out/permodel"
  emitPerModel  = "true"
  inputs        = ["where", "create"]
  relations     = "false"
  enumType      = "uint8"
  enumStart     = "1"
  enumDirective = "stringer -type={name}"
  enumer        = "false"
  types         = ["db.Uuid=string"]
  generateGoMod = "true"
  goModule      = "example.com/e2e/permodel"
  goVersion     = "1.27"
}

// Post-generation steps: enumer when it is installed, then `go generate` over a directive that
// leaves a marker file behind.
generator poststeps {
  provider      = "node ./bin/prisma-go-generator.js"
  output        = "../out/poststeps"
  enumDirective = "touch {name}.generated"
  runGoGenerate = "true"
  generateGoMod = "true"
  goModule      = "example.com/e2e/poststeps"
  goVersion     = "1.27"
}

// Inputs in a package of their own, one file in each directory. The models package is not named
// after its directory, as in `output = "../gomodels"` with `package = "prisma"`.
generator splitsingle {
  provider      = "node ./bin/prisma-go-generator.js"
  output        = "../out/splitsingle"
  package       = "store"
  inputs        = "all"
  inputsOutDir  = "inputs"
  enumer        = "false"
  generateGoMod = "true"
  goModule      = "example.com/e2e/splitsingle"
  goVersion     = "1.27"
}

// The same per .prisma file, in a nested directory with a package name of its own. There is no
// go.mod in the output directory: the import path comes from the one above it, which the test writes.
generator splitperfile {
  provider      = "node ./bin/prisma-go-generator.js"
  output        = "../out/splitperfile/db"
  emitPerFile   = "true"
  inputs        = ["where", "update"]
  inputsOutDir  = "query/inputs"
  inputsPackage = "query"
  enumType      = "string"
  types         = ["db.Uuid=uuid.UUID"]
  runGoGenerate = "true" // has to cope with both directories, though neither has a directive
}

// The same per model. These families have no shared types, so there is no inputs.go.
generator splitpermodel {
  provider      = "node ./bin/prisma-go-generator.js"
  output        = "../out/splitpermodel"
  emitPerModel  = "true"
  inputs        = ["whereUnique", "create", "include"]
  inputsOutDir  = "inputs"
  enumer        = "false"
  generateGoMod = "true"
  goModule      = "example.com/e2e/splitpermodel"
  goVersion     = "1.27"
}
